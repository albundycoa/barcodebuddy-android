<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/feedback_header">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="use_vibration"
            app:title="@string/use_vibration" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="use_beep"
            app:title="@string/use_beep" />

        <SeekBarPreference
            android:max="20"
            app:defaultValue="5"
            app:dependency="use_beep"
            app:key="volume_beep"
            app:title="@string/volume" />

    </PreferenceCategory>
    <PreferenceCategory app:title="@string/onb_pref_header">

        <Preference
            app:key="onboarding"
            app:summary="@string/onb_pref_summary"
            app:title="@string/onb_pref_title">
            <intent
                android:targetClass="de.bulling.barcodebuddyscanner.OnboardingActivity"
                android:targetPackage="de.bulling.barcodebuddyscanner" />
        </Preference>

    </PreferenceCategory>
    <PreferenceCategory app:title="@string/menu_order_header">

        <ListPreference
            android:defaultValue="system"
            android:entries="@array/theme_mode"
            android:entryValues="@array/theme_mode_val"
            android:summary="%s"
            app:key="theme_mode"
            app:title="@string/theme_mode_title" />

        <Preference
            app:key="menu_order"
            app:summary="@string/menu_order_pref_summary"
            app:title="@string/menu_order_title">
            <intent
                android:targetClass="de.bulling.barcodebuddyscanner.MenuOrderActivity"
                android:targetPackage="de.bulling.barcodebuddyscanner" />
        </Preference>

    </PreferenceCategory>
    <PreferenceCategory app:title="@string/update_header">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="update_check"
            app:summary="@string/update_check_summary"
            app:title="@string/update_check_title" />

        <EditTextPreference
            app:key="update_url"
            app:title="@string/update_url_title" />

        <Preference
            app:key="app_version"
            app:selectable="false"
            app:title="@string/app_version_title" />

    </PreferenceCategory>
    <PreferenceCategory app:title="@string/bb_header">

        <Preference
            app:key="bb_connection"
            app:summary="@string/bb_pref_summary"
            app:title="@string/bb_title">
            <intent
                android:targetClass="de.bulling.barcodebuddyscanner.BbSettingsActivity"
                android:targetPackage="de.bulling.barcodebuddyscanner" />
        </Preference>

    </PreferenceCategory>
    <PreferenceCategory app:title="@string/grocy_header">

        <Preference
            app:key="grocy_connection"
            app:summary="@string/grocy_pref_summary"
            app:title="@string/grocy_title">
            <intent
                android:targetClass="de.bulling.barcodebuddyscanner.GrocySettingsActivity"
                android:targetPackage="de.bulling.barcodebuddyscanner" />
        </Preference>

        <ListPreference
            android:defaultValue="grocy"
            android:entries="@array/booking_mode"
            android:entryValues="@array/booking_mode_val"
            android:summary="%s"
            app:key="booking_mode"
            app:title="@string/booking_mode" />

        <ListPreference
            android:defaultValue="book"
            android:entries="@array/manual_done_mode"
            android:entryValues="@array/manual_done_mode_val"
            android:summary="%s"
            app:key="manual_done_mode"
            app:title="@string/manual_done_mode" />

        <ListPreference
            android:defaultValue="open"
            android:entries="@array/sync_mode"
            android:entryValues="@array/sync_mode_val"
            android:summary="%s"
            app:key="sync_mode"
            app:title="@string/sync_mode" />

        <Preference
            app:key="products"
            app:summary="@string/products_pref_summary"
            app:title="@string/products_title">
            <intent
                android:targetClass="de.bulling.barcodebuddyscanner.ProductsActivity"
                android:targetPackage="de.bulling.barcodebuddyscanner" />
        </Preference>

        <Preference
            app:key="group_order"
            app:summary="@string/group_order_pref_summary"
            app:title="@string/group_order_title">
            <intent
                android:targetClass="de.bulling.barcodebuddyscanner.GroupOrderActivity"
                android:targetPackage="de.bulling.barcodebuddyscanner" />
        </Preference>

        <Preference
            app:key="shop_order"
            app:summary="@string/shop_order_pref_summary"
            app:title="@string/shop_order_title">
            <intent
                android:targetClass="de.bulling.barcodebuddyscanner.ShopOrderActivity"
                android:targetPackage="de.bulling.barcodebuddyscanner" />
        </Preference>

    </PreferenceCategory>
    <PreferenceCategory app:title="@string/off_header">

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:summary="@string/off_lookup_summary"
            app:key="off_lookup"
            app:title="@string/off_lookup_title" />

        <SwitchPreferenceCompat
            android:defaultValue="true"
            android:summary="@string/off_images_grocy_summary"
            app:key="off_images_grocy"
            app:title="@string/off_images_grocy_title" />

        <Preference
            android:summary="@string/off_images_summary"
            app:key="off_images_all"
            app:title="@string/off_images_title" />

    </PreferenceCategory>
    <PreferenceCategory app:title="@string/scanner_header">


        <ListPreference
            android:defaultValue="scanner"
            android:entries="@array/scan_method"
            android:entryValues="@array/scan_method_val"
            android:summary="%s"
            app:key="scan_method"
            app:title="@string/scan_method" />

        <Preference
            app:key="spp_device"
            app:title="@string/spp_device_title" />

        <Preference
            app:key="spp_pairing_code"
            app:summary="@string/spp_pairing_pref_summary"
            app:title="@string/spp_pairing_title" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="scan_notification"
            app:summary="@string/scan_notification_summary"
            app:title="@string/scan_notification" />

        <ListPreference
            android:defaultValue="connected"
            android:entries="@array/scanner_standby"
            android:entryValues="@array/scanner_standby_val"
            android:summary="%s"
            app:key="scanner_standby"
            app:title="@string/scanner_standby" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="scanner_auto_control"
            app:summary="@string/scanner_auto_control_summary"
            app:title="@string/scanner_auto_control" />

        <EditTextPreference
            android:defaultValue="5"
            android:dialogMessage="@string/battery_interval_hint"
            app:key="battery_interval"
            app:title="@string/battery_interval" />

    </PreferenceCategory>

</PreferenceScreen>

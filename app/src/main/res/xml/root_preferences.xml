<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/feedback_header">

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="use_vibration"
            app:title="@string/use_vibration" />

        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="use_beep"
            app:title="@string/use_beep" />

        <SeekBarPreference
            android:max="20"
            app:defaultValue="5"
            app:dependency="use_beep"
            app:key="volume_beep"
            app:title="@string/volume" />

    </PreferenceCategory>
    <PreferenceCategory app:title="@string/grocy_header">

        <Preference
            app:key="grocy_connection"
            app:summary="@string/grocy_pref_summary"
            app:title="@string/grocy_title">
            <intent
                android:targetClass="de.bulling.barcodebuddyscanner.GrocySettingsActivity"
                android:targetPackage="de.bulling.barcodebuddyscanner" />
        </Preference>

        <Preference
            app:key="shop_order"
            app:summary="@string/shop_order_pref_summary"
            app:title="@string/shop_order_title">
            <intent
                android:targetClass="de.bulling.barcodebuddyscanner.ShopOrderActivity"
                android:targetPackage="de.bulling.barcodebuddyscanner" />
        </Preference>

    </PreferenceCategory>
    <PreferenceCategory app:title="@string/scanner_header">

        <ListPreference
            android:defaultValue="0"
            android:entries="@array/orientation"
            android:summary="%s"
            android:entryValues="@array/orientation_val"
            app:title="@string/orientation"
            app:key="orientation" />


        <ListPreference
            android:defaultValue="scanner"
            android:entries="@array/scan_method"
            android:entryValues="@array/scan_method_val"
            android:summary="%s"
            app:key="scan_method"
            app:title="@string/scan_method" />

        <Preference
            app:key="spp_device"
            app:title="@string/spp_device_title" />

    </PreferenceCategory>

</PreferenceScreen>

<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 und neuer: Die API-Schlüssel bleiben aus dem Cloud-Backup, beim Gerätewechsel per Kabel gehen sie mit. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="de.bulling.barcodebuddyscanner_preferences.xml" />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
